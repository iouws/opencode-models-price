{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-models-price",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode TUI plugin that shows the selected model's input/output price next to its name",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "pricing",
    "models"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iouws/opencode-models-price.git"
  },
  "homepage": "https://github.com/iouws/opencode-models-price#readme",
  "bugs": {
    "url": "https://github.com/iouws/opencode-models-price/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.1"
  },
  "devDependencies": {
    "@opencode/client": "2.2.1",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
